# Copie para .env e preencha. NUNCA commite o .env.
NODE_ENV=development
PORT=3000
# Desenvolvimento: banco local. Produção: o provedor injeta esta variável.
DATABASE_URL=postgres://usuario:senha@localhost:5432/caixa
# Produção (Render) exige SSL; use true lá e false no desenvolvimento.
DATABASE_SSL=false
